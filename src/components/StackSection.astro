---
import Icon from './Icon.astro';
import { stackGroups } from '../lib/site';
---

<section id="stack" class="section border-y border-border bg-bg-elevated">
  <div class="container-site">
    <p class="mono-label text-accent">03 — Stack</p>
    <h2 class="mt-3 text-h1">Con qué trabajo</h2>

    <dl class="card mt-10 divide-y divide-border" data-reveal>
      {
        stackGroups.map((group) => (
          <div class="grid gap-3 p-5 sm:grid-cols-[12rem_1fr] sm:items-center sm:p-6">
            <dt class="mono-label text-faint">{group.title}</dt>
            <dd>
              <ul class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="badge px-2.5 py-1.5 text-[0.8125rem] text-text">
                    <Icon name={item} class="size-3.5 text-muted" />
                    {item}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
