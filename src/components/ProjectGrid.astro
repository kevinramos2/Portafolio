---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { formatMonth, getRepos, lastPush } from '../lib/github';
import { site } from '../lib/site';

const all = (await getCollection('projects')).map((e) => e.data).sort((a, b) => a.order - b.order);
const live = all.filter((p) => p.featured);
const academic = all.filter((p) => !p.featured);
const repos = await getRepos(site.user);
const updated = (p: (typeof all)[number]) => {
  const pushed = lastPush(repos, p.relatedRepos?.map((r) => r.name) ?? [p.repoName]);
  return pushed && formatMonth(pushed);
};
---

<section id="proyectos" class="section">
  <div class="container-site">
    <p class="mono-label text-accent">01 — Proyectos</p>
    <h2 class="mt-3 text-h1">Proyectos en vivo</h2>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {live.map((p) => <ProjectCard project={p} updated={updated(p)} />)}
    </div>
  </div>
</section>

<section id="academico" class="section pt-0">
  <div class="container-site">
    <p class="mono-label text-accent">02 — Académico</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <h2 class="text-h1">Trabajo académico</h2>
      <p class="max-w-[44ch] text-sm text-muted">Proyectos de curso, laboratorios y retos de la carrera.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {academic.map((p) => <ProjectCard project={p} updated={updated(p)} />)}
    </div>
  </div>
</section>
