---
import Icon from './Icon.astro';
import { site } from '../lib/site';

const mailto = site.email && `mailto:${site.email}?subject=${encodeURIComponent(site.emailSubject)}`;
---

<section id="contacto" class="section border-t border-border bg-bg-elevated">
  <div class="container-site">
    <p class="mono-label text-accent">05 — Contacto</p>
    <h2 class="mt-3 max-w-[16ch] text-display text-balance">¿Tienes un problema que resolver?</h2>
    <p class="mt-6 max-w-[52ch] text-lg text-muted">
      Me interesan los proyectos donde el software tiene que funcionar para alguien de verdad. Escríbeme y lo
      conversamos.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      {
        mailto && (
          <a href={mailto} class="btn btn-primary">
            {site.email}
          </a>
        )
      }
      <a href={site.github} target="_blank" rel="noopener" class:list={['btn', mailto ? 'btn-ghost' : 'btn-primary']}>
        <Icon name="github" class="size-4" />
        github.com/{site.user}
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <p class="mono-label mt-10 text-faint">{site.location} · {site.timezone}</p>
  </div>
</section>
