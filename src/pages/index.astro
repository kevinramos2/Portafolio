---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import IconSprite from '../components/IconSprite.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import StackSection from '../components/StackSection.astro';
import Timeline from '../components/Timeline.astro';
import TopBar from '../components/TopBar.astro';
import { site } from '../lib/site';
---

<BaseLayout>
  <IconSprite />
  <TopBar />
  <main id="contenido">
    <Hero />
    <ProjectGrid />
    <StackSection />
    <Timeline />
    <ContactSection />
  </main>
  <footer class="border-t border-border">
    <div class="container-site flex flex-wrap items-center justify-between gap-3 py-6 font-mono text-xs text-faint">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <p>
        Hecho con Astro ·
        <a
          href={`${site.github}/Portafolio`}
          target="_blank"
          rel="noopener"
          class="underline underline-offset-4 hover:text-accent"
        >
          código de este sitio
        </a>
      </p>
    </div>
  </footer>
</BaseLayout>
