---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav, site, withBase } from '../lib/site';

const home = withBase('/');
---

<BaseLayout title={`404 — Página no encontrada · ${site.name}`} noindex>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-sm">
    <div class="container-site flex h-14 items-center justify-between gap-4">
      <a href={home} class="flex h-11 items-center gap-2 font-mono text-sm font-bold text-text">
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        {site.user}
      </a>
      <span class="mono-label text-faint">Error 404</span>
    </div>
  </header>

  <main id="contenido" class="relative overflow-hidden pt-14">
    <div class="glow" aria-hidden="true"></div>
    <div
      class="container-site relative grid min-h-[calc(100dvh-3.5rem)] content-center gap-12 py-16 lg:grid-cols-[1fr_minmax(0,30rem)] lg:items-center"
    >
      <div>
        <p class="mono-label text-accent">Ruta no encontrada</p>
        <h1 class="code mt-4 font-extrabold text-text" aria-label="Error 404">
          4<span class="text-accent">0</span>4
        </h1>
        <p class="mt-6 max-w-[40ch] text-h2 text-balance">Esta página no existe, pero el resto del sitio sí.</p>
        <p class="mt-4 max-w-[48ch] text-muted">
          Puede que el enlace esté mal escrito o que la página haya cambiado de lugar. Desde aquí llegas a todo lo demás.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={home} class="btn btn-primary">Volver al inicio</a>
          <a href={`${home}#proyectos`} class="btn btn-ghost">Ver proyectos</a>
        </div>
      </div>

      <div class="card overflow-hidden font-mono text-sm leading-7">
        <div class="flex items-center gap-2 border-b border-border bg-surface-hover px-4 py-3" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-border-strong"></span>
          <span class="size-2.5 rounded-full bg-border-strong"></span>
          <span class="size-2.5 rounded-full bg-accent"></span>
          <span class="ml-2 text-xs text-faint">{site.user}@portafolio: ~</span>
        </div>
        <div class="p-5">
          <p class="line" style="--d: 0.2s">
            <span class="prompt" aria-hidden="true">$</span> cd <span data-path class="break-all">/esta-pagina</span>
          </p>
          <p class="line text-muted" style="--d: 0.8s">
            cd: <span data-path class="break-all">/esta-pagina</span>: no existe el archivo o el directorio
          </p>
          <p class="line" style="--d: 1.4s"><span class="prompt" aria-hidden="true">$</span> echo $?</p>
          <p class="line text-muted" style="--d: 1.9s">404</p>
          <p class="line" style="--d: 2.5s"><span class="prompt" aria-hidden="true">$</span> ls ~/</p>
          <ul class="line flex flex-wrap gap-x-5" style="--d: 3s" aria-label="Secciones del sitio">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={`${home}${item.href}`}
                    class="inline-flex min-h-11 items-center text-accent underline-offset-4 hover:underline"
                  >
                    {item.label.toLowerCase()}/
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="line" style="--d: 3s">
            <span class="prompt" aria-hidden="true">$</span>
            <span class="cursor" aria-hidden="true"></span>
          </p>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    // Muestra en la terminal la ruta que se pidió de verdad.
    (() => {
      const path = decodeURIComponent(location.pathname).slice(0, 80);
      document.querySelectorAll('[data-path]').forEach((el) => (el.textContent = path));
    })();
  </script>
</BaseLayout>

<style>
  .glow {
    position: absolute;
    top: -120px;
    left: 50%;
    width: 900px;
    height: 600px;
    translate: -50% 0;
    background: radial-gradient(closest-side, var(--color-accent-glow), transparent);
    pointer-events: none;
  }

  .code {
    font-size: clamp(6rem, 22vw, 13rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .line {
    animation: appear 1ms linear var(--d) both;
  }

  .prompt {
    color: var(--color-terminal);
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    margin-left: 0.25rem;
    vertical-align: text-bottom;
    background: var(--color-terminal);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
